{
  "name": "xolot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11 <12"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts",
    "test:ui": "jest --runInBand",
    "test:rules": "node scripts/test-rules.mjs",
    "test:queries:config": "node scripts/check-query-indexes.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "test:package:functions": "node scripts/check-functions-package.mjs",
    "test:backend": "pnpm --dir functions run build && node --test tests/backend/*.test.mjs",
    "web": "expo start --web",
    "build:web": "node scripts/clean-dist.mjs && expo export --clear --platform web --output-dir dist && node scripts/prepare-web.mjs && workbox generateSW workbox-config.js",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "pnpm --dir functions exec tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "format:check": "node scripts/format.mjs",
    "format": "node scripts/format.mjs --write",
    "refactor:status": "node scripts/refactor-progress.mjs status",
    "firebase": "firebase",
    "deploy:firebase": "pnpm run build:web && pnpm exec firebase deploy --only functions,hosting:xolot,firestore",
    "deploy:firebase:functions": "pnpm --filter xolot-functions run build && pnpm exec firebase deploy --only functions",
    "deploy:firebase:hosting": "pnpm run build:web && pnpm exec firebase deploy --only hosting:xolot"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~54.0.0",
    "expo-auth-session": "^7.0.11",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.9",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-splash-screen": "~31.0.13",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "^15.0.11",
    "firebase": "^12.16.0",
    "lucide-react-native": "^1.24.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "9.39.1",
    "eslint-config-expo": "10.0.0",
    "firebase-tools": "15.34.1",
    "jest": "29.7.0",
    "jest-expo": "54.0.17",
    "prettier": "3.8.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "workbox-cli": "^7.4.1",
    "yaml": "2.9.0"
  }
}
