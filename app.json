{
  "expo": {
    "name": "Folko",
    "slug": "xolot",
    "scheme": "xolot",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/folko-app-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090A0F",
    "splash": {
      "image": "./assets/brand/folko-primary-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#090A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/brand/folko-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/folko-adaptive-icon.png",
        "backgroundColor": "#090A0F"
      },
      "edgeToEdgeEnabled": true
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#090A0F"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#090A0F"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/folko-app-icon.png",
      "name": "Folko",
      "shortName": "Folko",
      "description": "Uma rede social para compartilhar e divulgar o que você faz.",
      "themeColor": "#090A0F",
      "backgroundColor": "#090A0F",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-video",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090A0F",
          "image": "./assets/brand/folko-primary-transparent.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Folko acesse suas fotos e videos para criar publicacoes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permita que o Folko mostre a midia mais recente da sua galeria.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Folko use a camera para registrar seus vídeos e publicações.",
          "microphonePermission": "Permita que o Folko use o microfone durante a gravacao dos seus vídeos e publicações.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
