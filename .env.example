# Firebase (Authentication > Email/Senha e Google habilitados no console)
EXPO_PUBLIC_FIREBASE_API_KEY=
# Opcional: chave restrita a referrers web; nunca usada em Android/iOS.
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MEDIA_ENABLED=false
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudflare R2 (somente valores publicos; nunca adicione chaves R2 aqui)
EXPO_PUBLIC_R2_MEDIA_ENABLED=false
EXPO_PUBLIC_R2_MEDIA_URL=https://media.xolot.com.br

# URL publica usada nos links de verificacao e recuperacao
EXPO_PUBLIC_APP_URL=https://xolot.com.br

# Chave publica do reCAPTCHA Enterprise para Firebase App Check (web)
EXPO_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Ativar só após registrar o site key e validar clientes no Firebase App Check
EXPO_PUBLIC_REQUIRE_APP_CHECK=false
# Exige inicialização somente no web, sem afetar clientes nativos.
EXPO_PUBLIC_REQUIRE_WEB_APP_CHECK=false
# Requer habilitação de bot protection para passwordProvider no Identity Platform
EXPO_PUBLIC_AUTH_RECAPTCHA_ENABLED=false

# Diagnóstico operacional: ativar somente após publicar/validar o coletor e revisar acesso/retenção dos logs.
EXPO_PUBLIC_OPERATION_METRICS_ENABLED=false
# SHA curto/longo do commit do build. Não usar nome, UID ou URL.
EXPO_PUBLIC_RELEASE_ID=

# Google Cloud OAuth Client IDs
# Web client: obrigatorio para web e como webClientId no mobile
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Opcionais para builds nativos (iOS/Android)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
